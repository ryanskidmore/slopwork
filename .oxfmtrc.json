{
  // Formatting options below were generated by `oxfmt --migrate=biome`, so
  // switching formatters was not also a restyle: they reproduce the exact
  // Biome settings this repo used before (docs/DECISIONS.md's oxfmt entry).
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,

  // Scope deliberately matches Biome's old `includes` (src/**, tests/**,
  // *.json, *.jsonc, .github/**) so this migration is a formatter swap and
  // nothing else. `.gitignore` is honored automatically, which already covers
  // dist/, coverage/, node_modules/, and .slop/db/index.jsonc.
  "ignorePatterns": [
    // LOAD-BEARING — do not remove. `.slop/db/**` is slopwork's OWN database
    // (tickets/sessions/events .jsonc). Unlike ordinary .jsonc source it is
    // machine-written, by src/core/jsonc.ts's canonical writer under its own
    // FORMATTING_OPTIONS (eol "\n"), with .gitattributes forcing LF on
    // checkout to keep the git-merge story intact. Letting a general-purpose
    // formatter rewrite these would corrupt the committed db, break the
    // round-trip/merge tests, and make the repo misrepresent what `slop`
    // actually emits. Verified: with these patterns a full format run leaves
    // every fixture byte-identical.
    ".slop/**",
    "**/.slop/**",
    "tests/fixtures/**",

    // Markdown was never in Biome's `includes`, so it stays unformatted here
    // too — reflowing every doc would bury this migration's real diff.
    "**/*.md",

    // Also outside Biome's old scope. `.claude/settings.local.json` is a
    // developer's UNTRACKED local file — it is ignored via a global gitignore
    // rather than this repo's own, so oxfmt (which only reads the repo's
    // .gitignore) would otherwise happily rewrite someone's local settings.
    ".claude/**"

    // NOTE (rewrite-slop-web-as-a): the `src/web/views/**` / `src/web/html.test.ts`
    // exclusion that used to live here is gone — this rewrite deleted both
    // (the server-rendered `html`` tagged-template views, replaced by the
    // SPA + JSON API). The new `.tsx`/`.ts` under src/web/ has no such
    // hazard and formats normally, same as everything else in scope.
  ]
}
