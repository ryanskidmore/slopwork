# .slop/db/*.jsonc files are written with LF line endings by
# src/core/jsonc.ts's shared FORMATTING_OPTIONS (eol: "\n"). Force LF on
# checkout too, so a non-Linux clone can't reintroduce CRLF noise and
# quietly break the diff-minimal-write / git-merge story the flatfile db
# depends on (docs/spikes/jsonc.md, "Recommended FormattingOptions").
*.jsonc text eol=lf

# Tracker database — machine-written by slop. Mark as generated so code
# hosts collapse these files in PR/MR diffs by default (linguist-generated
# is GitHub's marker, gitlab-generated is GitLab's).
.slop/db/** linguist-generated gitlab-generated
