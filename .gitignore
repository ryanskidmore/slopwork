# dependencies
node_modules/

# build output
dist/
# generated by `bun run build:web` (scripts/build-frontend.ts) — the bundled
# SPA (src/web/frontend/) + its base64-inlined font CSS, regenerated on every
# `bun run build`/`bun run test` (see package.json's prebuild/pretest hooks),
# never hand-edited.
src/web/generated/
src/web/frontend/fonts.generated.css

# test / coverage
coverage/
*.tsbuildinfo

# logs
*.log
npm-debug.log*

# editor / OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.swp

# env
.env
.env.local

# Biome
.biome-cache/

# NOTE: this repo's OWN .slop/ is dogfood data and remains tracked. `slop init`
# writes only ephemeral db paths into the target repo's managed section; that
# runtime behavior is separate from this repo's own tooling configuration.


# agent worktrees (temporary, isolated)
.claude/worktrees/


# benchmark fixtures (bench/run.ts --dir)
.bench-work/

# --- slopwork (managed by `slop init`) ---
.slop/db/index.jsonc
.slop/db/.lock
.slop/db/.lock.stale-*
.slop/db/.tmp-*
.slop/db/*/.tmp-*
# --- end slopwork ---
