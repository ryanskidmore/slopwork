# dependencies
node_modules/

# build output
dist/
# generated by `bun run build:web` (scripts/build-frontend.ts) — the bundled
# SPA (src/web/frontend/) + its base64-inlined font CSS, regenerated on every
# `bun run build`/`bun run test` (see package.json's prebuild/pretest hooks),
# never hand-edited.
src/web/generated/
src/web/frontend/fonts.generated.css

# test / coverage
coverage/
*.tsbuildinfo

# logs
*.log
npm-debug.log*

# editor / OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.swp

# env
.env
.env.local

# Biome
.biome-cache/

# NOTE: this repo's OWN .slop/ (if this repo dogfoods itself later) is not
# ignored here. `slop init` (work item D1) writes .slop/db/index.jsonc and
# .slop/transcripts/ gitignore entries into the *target* repo it runs in,
# per D14/D16 — that is a runtime concern of the tool, not this repo's own
# tooling config.


# agent worktrees (temporary, isolated)
.claude/worktrees/


# benchmark fixtures (bench/run.ts --dir)
.bench-work/

# --- slopwork (managed by `slop init`) ---
.slop/db/index.jsonc
.slop/db/.lock
.slop/db/.lock.stale-*
.slop/db/.tmp-*
.slop/db/*/.tmp-*
.slop/transcripts/
# --- end slopwork ---
