{
  "id": "ticket_01KZ11CQSZDEPJRS4V057PVAYN",
  "name": "Make flatfile lock acquisition and release token-safe",
  "slug": "fix/audit-lock-safety",
  "spec": {
    "summary": "Restore strict mutual exclusion for the flatfile write lock.",
    "details_md": "Replace pid-only lock ownership and unsafe stale-lock relocation with a unique acquisition identity, token-aware release, and conservative stale recovery that never steals from a potentially live process.",
    "acceptance": [
      "Concurrent contenders cannot overlap through a stale-break race.",
      "Release cannot delete a replacement lock, including replacements owned by the same pid.",
      "A distinct token identifies every acquisition and same-pid nested/competing acquisitions remain distinct.",
      "Stale recovery only removes locks whose owner is confirmed dead; age alone never steals from a potentially live owner."
    ],
    "context": [
      "src/repo/lock.ts",
      "src/repo/lock.test.ts"
    ],
