  "name": "web: add Host-header allowlist to block DNS rebinding",
  "slug": "web-add-host-header-allowlist",
  "spec": {
    "summary": "web: add Host-header allowlist to block DNS rebinding",
    "details_md": "server.ts binds 127.0.0.1 but validates no Host/Origin; a malicious site can DNS-rebind to 127.0.0.1:4553 and scrape tickets+transcripts (which often contain secrets). One-line allowlist: localhost/127.0.0.1/[::1].",
    "acceptance": [
      "requests with a foreign Host header get 403",
      "normal browsing unaffected"
    ],
    "context": [
      "src/web/server.ts:55"
    ],
    "meta": {},
    "v": 1
  },
