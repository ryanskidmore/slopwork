{
  "id": "ticket_01KZ13ABCGGZKREQS5AWCVTJRN",
  "name": "Attribute ticket mutations to active sessions",
  "slug": "fix/ticket-event-session-attribution",
  "spec": {
    "summary": "Ensure ticket-scoped mutation events carry the ticket's current active session while preserving deliberate no-session cases and correct concurrency snapshots.",
    "details_md": "",
    "acceptance": [
      "Update, edit, split, ask, and answer events use the affected ticket's active session when one exists.",
      "Bulk updates attribute each ticket independently; reparent descendant events use fresh within-transaction session state.",
      "Lock-free progress uses its initial ticket snapshot; answer after restart uses the new active session, not the session that asked.",
      "Split child creation attribution is explicitly defined and tested relative to the active parent session.",
      "Open tickets without active sessions continue emitting session:null.",
      "G5 unit, command, acceptance, and CLI/web visibility regressions pass with full static/build gates."
    ],
    "context": [
