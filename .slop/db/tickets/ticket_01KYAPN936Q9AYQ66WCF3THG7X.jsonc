  "spec": {
    "summary": "web: every request full-rescans the db; ticket detail double-scans tickets and sessions dirs",
    "details_md": "No caching: each route re-reads+parses whole directories; handleTicketDetail scans tickets twice (findTicketByRef + listTickets) and sessions twice (listSessionsForTicket + listEventsForTicket which calls it again). Fine at hundreds; noticeable at 1k+ with a big events dir. Cheap wins: reuse a single scan per request, mtime-keyed cache later.",
    "acceptance": [
      "one scan per directory per request"
