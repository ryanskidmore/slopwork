  "slug": "web-jira-remote-url-not",
  "spec": {
    "summary": "web: jira remote URL not scheme-checked — stored XSS via config.yaml",
    "details_md": "`externalParentBadge` (src/web/views/shared.ts:127-129) builds `href` from `config.remotes.jira` without `safeUrl`, unlike renderMrLink. zod `z.url()` accepts javascript:/data:/vbscript: schemes, and config.yaml is collaborator-editable/git-merged. Clicking the jira badge executes JS in the web UI origin, which can read transcripts.",
    "acceptance": [
      "jira base URL routed through safeUrl (or scheme allowlist http/https) before rendering",
      "regression test with a javascript: remote"
    ],
    "context": [
      "src/web/views/shared.ts:127",
      "src/web/views/ticket-detail.ts:79 (safeUrl precedent)"
    ],
