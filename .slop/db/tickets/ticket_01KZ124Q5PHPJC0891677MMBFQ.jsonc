{
  "id": "ticket_01KZ124Q5PHPJC0891677MMBFQ",
  "name": "Harden release and package verification",
  "slug": "harden-release-and-package-verification",
  "spec": {
    "summary": "Guard manual releases and verify the installable tarball through one shared CI/release contract.",
    "details_md": "Manual workflow dispatch can currently publish arbitrary refs, release validation is weaker than CI, and package checks do not install or execute the packed artifact. Make manual dispatch dry-run-only, centralize required validation, and add deterministic installed-tarball verification.",
    "acceptance": [
      "Manual workflow_dispatch cannot publish a package from an arbitrary ref.",
      "CI and release reuse the same required validation commands and deterministic package verifier.",
      "The verifier packs and installs the tarball, executes slop --version and --help, and checks runtime entry and generated web assets."
    ],
    "context": [
      ".github/workflows/ci.yml",
      ".github/workflows/release.yml",
      "package.json",
      "docs/RELEASE.md"
    ],
