  "name": "Bound web ticket listing and search requests",
  "slug": "bound-web-ticket-listing-and",
  "spec": {
    "summary": "Add a stable bounded pagination contract and responsive, abortable ticket-list and command-palette search UI.",
    "details_md": "",
    "acceptance": [
      "Ticket list filters and stable sort are applied before a server-enforced bounded slice with total and next-page metadata.",
      "Ticket list pagination is URL-backed and search is debounced, abortable, and visibly pending without stale-row ambiguity.",
      "Command palette performs bounded server-side search, cancels superseded requests, and distinguishes errors from empty results.",
      "API and large-list tests prove bounded payloads, stable order, and no duplicates across pages; relevant controls have accessible names."
