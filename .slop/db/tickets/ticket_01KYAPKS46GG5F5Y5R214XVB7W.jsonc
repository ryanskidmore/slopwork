  "spec": {
    "summary": "duration: huge stale_after overflows Date and crashes every index build",
    "details_md": "parseDurationMs has no magnitude bound; stale_after: 99999999999d passes config schema, then computeStalenessDeadlines toISOString throws RangeError inside buildIndex, breaking status/ready/reindex repo-wide. Users plausibly set huge values to disable staleness. Clamp or treat overflow as no-deadline.",
    "acceptance": [
      "absurd durations clamp to null deadline (staleness disabled) with a warning",
      "regression test"
    ],
