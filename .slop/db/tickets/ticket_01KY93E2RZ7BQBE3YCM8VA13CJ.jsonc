{
  "id": "ticket_01KY93E2RZ7BQBE3YCM8VA13CJ",
  "name": "gitignore .slop/db/.lock and .tmp-* so a crash+commit cannot poison merges or fresh clones",
  "slug": "gitignore-slop-db-lock-and-tmp-so-a-crash-commit-cannot-pois",
  "spec": {
    "summary": "computeGitignoreLines only ignores index.jsonc and transcripts/. A kill -9 leaves .lock and .tmp-* on disk; git add -A commits them, so .lock round-trips through merge (conflict on an ephemeral file) and, on a fresh clone, its foreign pid can read as alive and stall every write for the full 5-min stale timeout.",
    "details_md": "",
    "acceptance": [
      "slop init writes gitignore entries for .slop/db/.lock and a temp glob (.slop/db/.tmp-* and .slop/db/*/.tmp-*)",
      "Optionally record hostname in LockInfo and treat a foreign-host lock as break-by-timeout only",
      "A test asserts the generated gitignore ignores a stray .lock and .tmp- file"
    ],
    "context": [
      "src/cli/init/gitignore.ts:22-28 computeGitignoreLines",
      "src/repo/lock.ts:161-169 isProcessAlive (host-local pid assumption), :425-426 release only on clean exit",
      "src/repo/atomic-write.ts temp file naming"
    ],
    "meta": {},
    "v": 1
  },
  "state": "done",
