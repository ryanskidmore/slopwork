{
  "id": "ticket_01KZ11CPQKWZKJVMFF6BWTVNYQ",
  "name": "Unify YAML configuration semantics",
  "slug": "unify-yaml-configuration-semantics",
  "spec": {
    "summary": "Replace divergent CLI/repo and web YAML parsing with one runtime-neutral canonical codec.",
    "details_md": "The restricted hand parser and Bun.YAML disagree on valid YAML values and backend selection. Route every configuration reader and writer through a maintained shared codec while retaining each caller's strict or tolerant failure policy.",
    "acceptance": [
      "CLI, repository/storage selection, init/instructions, and web config use one canonical codec.",
      "Bare backend, quoted escapes, booleans, flow maps, and block scalars have identical semantics across storage selection and /api/config.",
      "Focused conformance and acceptance tests pass, with supported YAML semantics documented."
    ],
    "context": [
      "src/cli/config-yaml.ts",
      "src/repo/config.ts",
      "src/web/data-source.ts",
      "src/web/api/config.ts"
    ],
