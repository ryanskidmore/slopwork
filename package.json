{
  "name": "slopwork",
  "version": "0.1.1",
  "description": "Free OSS work tracker built for agents — a dependency graph of tickets, worked through sessions with an auditable trail.",
  "keywords": [
    "agents",
    "ai-agents",
    "bun",
    "claude-code",
    "cli",
    "coding-agents",
    "issue-tracker",
    "local-first",
    "project-management",
    "task-tracker",
    "work-tracker"
  ],
  "homepage": "https://github.com/ryanskidmore/slopwork#readme",
  "bugs": {
    "url": "https://github.com/ryanskidmore/slopwork/issues"
  },
  "license": "MIT",
  "author": "Ryan Skidmore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanskidmore/slopwork.git"
  },
  "bin": {
    "slop": "./bin/slop.mjs"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "bun build ./src/cli/index.ts --compile --outfile dist/slop",
    "start": "bun src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "jsonc-parser": "^3.3.1",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.9.0",
    "oxfmt": "0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=18.0.0"
  }
}
