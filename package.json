{
  "name": "slopwork",
  "version": "0.2.0",
  "description": "Free OSS work tracker built for agents — a dependency graph of tickets, worked through sessions with an auditable trail.",
  "keywords": [
    "agents",
    "ai-agents",
    "bun",
    "claude-code",
    "cli",
    "coding-agents",
    "issue-tracker",
    "local-first",
    "project-management",
    "task-tracker",
    "work-tracker"
  ],
  "homepage": "https://github.com/ryanskidmore/slopwork#readme",
  "bugs": {
    "url": "https://github.com/ryanskidmore/slopwork/issues"
  },
  "license": "MIT",
  "author": "Ryan Skidmore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanskidmore/slopwork.git"
  },
  "bin": {
    "slop": "./bin/slop.mjs"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build:web": "bun scripts/build-frontend.ts",
    "dev:web": "bun scripts/build-frontend.ts --watch",
    "prebuild": "bun run build:web",
    "build": "bun build ./src/cli/index.ts --compile --outfile dist/slop",
    "start": "bun src/cli/index.ts",
    "pretest": "bun run build:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit && bun run typecheck:web",
    "typecheck:web": "tsc --noEmit -p src/web/frontend/tsconfig.json",
    "prepublishOnly": "bun run build:web && npm run typecheck"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "jsonc-parser": "^3.3.1",
    "ulid": "^3.0.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-separator": "^1.1.12",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.13",
    "@radix-ui/react-visually-hidden": "^1.2.8",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fast-check": "^4.9.0",
    "lucide-react": "^1.25.0",
    "oxfmt": "0.59.0",
    "oxlint": "^1.74.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=18.0.0"
  }
}
